# OpenSSL 3.5 (Debian 13) offers the post-quantum hybrid key exchange X25519MLKEM768 by default. Some IPTV providers'
# HTTPS servers answer that with "tlsv1 alert internal error" instead of falling back, so the server could not sync
# from them while TVs (Android's own TLS) could. Offer the classic groups only; TLS 1.3 and certificate checks stay.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
Groups = X25519:secp256r1:X448:secp384r1:secp521r1
